// Copy to Secrets.xcconfig (gitignored) and fill in from the Supabase dashboard → Project Settings → API.
// The $() trick stops xcconfig from treating // as a comment.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
REDIRECT_BASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co/functions/v1/redirect
// Google Cloud → APIs & Services → Credentials → OAuth client ID (type iOS, bundle id com.timalpers.shopping). Enables the Gmail import.
GOOGLE_OAUTH_CLIENT_ID = YOUR-CLIENT-ID.apps.googleusercontent.com
GOOGLE_OAUTH_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR-CLIENT-ID
